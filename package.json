{
  "name": "@saifymatteo/pi-orchestrator",
  "version": "0.2.2",
  "description": "Simple agent orchestration for pi coding agent (pi.dev)",
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "pi-package",
    "pi-extension",
    "pi.dev",
    "pi",
    "pi-coding-agent",
    "agents",
    "subagents",
    "orchestration",
    "orchestrator"
  ],
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "homepage": "https://github.com/saifymatteo/pi-orchestrator#readme",
  "bugs": {
    "url": "https://github.com/saifymatteo/pi-orchestrator/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/saifymatteo/pi-orchestrator.git"
  },
  "license": "MIT",
  "author": "saifymatteo",
  "directories": {
    "doc": "docs",
    "test": "tests"
  },
  "peerDependencies": {
    "@earendil-works/pi-agent-core": ">=0.84.0",
    "@earendil-works/pi-ai": ">=0.84.0",
    "@earendil-works/pi-coding-agent": ">=0.84.0",
    "@earendil-works/pi-tui": ">=0.84.0"
  },
  "dependencies": {
    "@sinclair/typebox": "^0.34.52",
    "jsonc-parser": "^3.3.1"
  },
  "scripts": {
    "test": "node --test --experimental-strip-types --import ./tests/register-stubs.mjs tests/config.test.ts tests/agents.test.ts tests/delegate.test.ts tests/width.test.ts tests/index.test.ts tests/rpc-waiters.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=22.6"
  },
  "devDependencies": {
    "typescript": "^7.0.2"
  }
}
